{
  "name": "euta-app",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "euta desktop app: run scripts, live view, history, AI terminal (hosts the user's own claude/codex CLI)",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "package": "node scripts/package.mjs",
    "release": "node scripts/package.mjs --release",
    "release:upload": "node scripts/release-upload.mjs",
    "icon": "node scripts/render-icon.mjs",
    "release:github": "node scripts/release-github.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "@euta/core": "link:../euta-engine/packages/core",
    "@euta/input-os": "link:../euta-engine/packages/input-os",
    "@euta/mcp-server": "link:../euta-engine/packages/mcp-server",
    "@euta/tc-doc": "link:../euta-engine/packages/tc-doc",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "tar-stream": "^3.2.2",
    "yaml": "^2.9",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.53.0",
    "playwright": "^1.64.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
